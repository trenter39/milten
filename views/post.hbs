<div id="navRow">
    <h1 id="postHeading">{{post.title}}</h1>
    <h1><a href="../home">Home</a></h1>
</div>
<h2 id="postDate">{{post.category}} | {{formatDate post.createdAt}}</h2>
<p id="postContent">
    {{{trimContent post.content}}}
</p>
<div id="commentSection">
    <h1 id="commentsHeader">Comments</h1>
    <form action="/post/{{post._id}}/comment" method="POST" id="commentForm">
        <div id="sendCommentSection">
            <input type="text" name="commentAuthor" id="commentAuthorInput" placeholder="Your name" required>
            <input type="text" name="commentContent" id="commentContentInput" placeholder="Comment?" required>
            <button type="submit" id="sendCommentButton">Send</button>
        </div>
    </form>
    {{#if comments}}
    {{#each comments}}
    <div class="commentBlock">
        <div class="commentHeader">
            <h3>{{this.author}}</h3>
            <span class="commentTime">{{formatDate this.createdAt}}</span>
        </div>
        <p class="commentContent">{{this.content}}</p>
    </div>
    {{/each}}
    {{else}}
    <p id="noCommentsParagraph">No comments yet. Be the first to start the conversation!</p>
    {{/if}}
</div>
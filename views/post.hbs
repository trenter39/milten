<h1 id='post-title'>{{ post.title }}</h1>
<div id='post-meta'>
    <span>{{ post.category }} | {{formatDate post.createdAt}}</span>
</div>
<div id='post-content'>{{{trimContent post.content}}}</div>
<div id='comment-section' data-post-id='{{ post.id }}'>
    <h1 id='comments-section'>Comments</h1>
    {{#if user}}
        <form id='comment-form'>
            <div id='send-comment-section'>
                <input
                    id='comment-content-input'
                    type='text'
                    name='comment-content'
                    placeholder='Comment'
                    required
                />
                <button id='send-comment-button' type='submit'>Send</button>
            </div>
        </form>
    {{else}}
        <p id='comment-login-prompt'>
            Please
            <a href='/login'>log in</a>
            to leave a comment. You can still read comments below.
        </p>
    {{/if}}
    {{#if comments}}
        {{#each comments}}
            <div
                class='comment-block'
                data-comment-id='{{ this.id }}'
                data-comment-user-id='{{ this.userID }}'
            >
                <div class='comment-header'>
                    <div class='comment-author-info'>
                        <h3>{{ this.author }}</h3>
                        <span class='comment-time'>{{formatDate this.createdAt}}</span>
                    </div>
                    {{#if ../user}}
                        {{#if (or (eq this.userID ../user.id) (eq ../user.role "admin"))}}
                            <div class='menu-wrapper'>
                                <button class='menu-button' aria-label='Comment options'>⋯</button>
                                <div class='menu' role='menu'>
                                    {{#if (eq this.userID ../user.id)}}
                                        <button
                                            class='comment-edit-btn'
                                            type='button'
                                            role='menuitem'
                                        >
                                            Edit
                                        </button>
                                    {{/if}}
                                    {{#if (or (eq this.userID ../user.id) (eq ../user.role "admin"))}}
                                        <button
                                            class='comment-delete-btn'
                                            type='button'
                                            role='menuitem'
                                        >
                                            Delete
                                        </button>
                                    {{/if}}
                                </div>
                            </div>
                        {{/if}}
                    {{/if}}
                </div>
                <p class='comment-content'>{{ this.content }}</p>
            </div>
        {{/each}}
    {{else}}
        <p id='no-comment-paragraph'>No comments yet. Be the first to start the conversation!</p>
    {{/if}}
    {{#if pagination}}
        {{#if (gt pagination.totalPages 1)}}
            <div id='pagination'>
                {{#if (gt pagination.page 1)}}
                    <a
                        class='pagination-link'
                        href='/post/{{ post.id }}?comments_page={{subtract pagination.page 1}}'
                    >Previous</a>
                {{/if}}

                {{#each (paginationPages pagination.page pagination.totalPages)}}
                    {{#if (eq this '...')}}
                        <span class='pagination-ellipsis'>{{ this }}</span>
                    {{else}}
                        {{#if (eq this ../pagination.page)}}
                            <span class='pagination-current'>{{ this }}</span>
                        {{else}}
                            <a
                                class='pagination-link'
                                href='/post/{{ ../post.id }}?comments_page={{ this }}'
                            >
                                {{ this }}
                            </a>
                        {{/if}}
                    {{/if}}
                {{/each}}

                {{#if (lt pagination.page pagination.totalPages)}}
                    <a
                        class='pagination-link'
                        href='/post/{{ post.id }}?comments_page={{add pagination.page 1}}'
                    >Next</a>
                {{/if}}
            </div>
        {{/if}}
    {{/if}}
</div>

<h2 class='page-header'>Your Account</h2>

<section class='profile-card'>
    <div class='profile-row'>
        <div class='label'>First name</div>
        <div class='value'>{{ profile.firstName }}</div>
    </div>
    <div class='profile-row'>
        <div class='label'>Last name</div>
        <div class='value'>{{ profile.lastName }}</div>
    </div>
    <div class='profile-row'>
        <div class='label'>Email address</div>
        <div class='value'>{{ profile.email }}</div>
    </div>
    <div class='profile-row'>
        <div class='label'>Creation date</div>
        <div id='profile-creation-date' class='value'>{{formatDate profile.createdAt}}</div>
    </div>
</section>

<h2 class='page-header'>Your Comments</h2>

{{#if comments.length}}
    <div class='comments-list'>
        {{#each comments}}
            <div class='comment-row'>
                <a class='comment-post-title' href='/post/{{ this.postID }}'>
                    {{ this.postTitle }}
                </a>
                <div class='comment-preview'>{{ this.preview }}</div>
                <div class='comment-time' data-time='{{ this.createdAt }}'>
                    {{formatDate this.createdAt}}
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <p class='no-comments-profile'>You haven't written any comments yet.</p>
{{/if}}

{{#if pagination}}
    {{#if (gt pagination.totalPages 1)}}
        <div id='pagination' style="margin-top: 0;">
            {{#if (gt pagination.page 1)}}
                <a
                    class='pagination-link'
                    href='/account?comments_page={{subtract pagination.page 1}}'
                >Previous</a>
            {{/if}}

            {{#each (paginationPages pagination.page pagination.totalPages)}}
                {{#if (eq this '...')}}
                    <span class='pagination-ellipsis'>{{ this }}</span>
                {{else}}
                    {{#if (eq this ../pagination.page)}}
                        <span class='pagination-current'>{{ this }}</span>
                    {{else}}
                        <a class='pagination-link' href='/account?comments_page={{ this }}'>
                            {{ this }}
                        </a>
                    {{/if}}
                {{/if}}
            {{/each}}

            {{#if (lt pagination.page pagination.totalPages)}}
                <a
                    class='pagination-link'
                    href='/account?comments_page={{add pagination.page 1}}'
                >Next</a>
            {{/if}}
        </div>
    {{/if}}
{{/if}}

<h2 class='page-header' style='padding-top: 20px; border-top: 1px solid var(--border-light);'>Settings</h2>

<section
    class='profile-card account-actions'
    data-first-name='{{ profile.firstName }}'
    data-last-name='{{ profile.lastName }}'
    data-email='{{ profile.email }}'
>
    <div class='account-action-row'>
        <div>
            <h3>Edit profile</h3>
            <p>Update your personal information</p>
        </div>
        <button id='account-edit-profile' class='primary' type='button'>Edit</button>
    </div>
    <div class='account-action-row'>
        <div>
            <h3>Change password</h3>
            <p>Update your password to keep your account secure</p>
        </div>
        <button id='account-change-password' class='primary' type='button'>Change</button>
    </div>
    <div class='account-action-row'>
        <div>
            <h3>Sign out</h3>
            <p>Log out of your current session on this device</p>
        </div>
        <button id='account-logout' class='primary' type='button'>Sign out</button>
    </div>
    <div class='account-action-row'>
        <div>
            <h3>Delete account</h3>
            <p>Remove your account and all associated data</p>
        </div>
        <button id='account-delete' class='danger' type='button'>Delete</button>
    </div>
</section>

<div id='account-modal' class='modal-confirm-overlay' style='display: none;'>
    <div class='modal-confirm-window' role='dialog' aria-modal='true' aria-labelledby='account-modal-title'>
        <h2 id='account-modal-title' class='modal-confirm-title'></h2>
        <p id='account-modal-desc' class='modal-confirm-desc'></p>
        <div id='account-modal-body'></div>
        <p id='account-modal-error' class='form-error' role='alert'></p>
        <div class='modal-confirm-actions'>
            <button id='account-modal-cancel' class='modal-cancel-btn' type='button'>Cancel</button>
            <button id='account-modal-confirm' class='modal-delete-btn' type='button'>Confirm</button>
        </div>
    </div>
</div>

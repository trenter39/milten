<div id='nav-row'>
    <h1>
        <a href='/'>Milten</a>
    </h1>
    <div class='action-captions'>
        {{#if isAuthenticated}}
            <a id='user-account' href='/account'>Account</a>
            {{#if isAdmin}}
                <a id='create-post-button' href='/new'>Create post</a>
            {{/if}}
        {{else}}

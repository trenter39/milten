<div id="nav-row">
    <h1><a href="/">Milten</a></h1>
    <div class="action-captions">
        {{#if isAuthenticated}}
            <a id="user-account" href="/account">Account</a>
            {{#if isAdmin}}
                <a href="/new" id="create-post-button">Create post</a>
            {{/if}}
        {{else}}
            <div class="auth-buttons">
                <a href="/login" id="sign-in-button">Sign in</a>
                <a href="/register" id="sign-up-button">Sign up</a>
            </div>
        {{/if}}
    </div>
</div>
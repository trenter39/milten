<h2 style='margin-bottom: 20px;'>Posts</h2>
<div id='post-filter'>
    <form id='search-form' action='/search' method='GET'>
        <input id='search-input' type='text' name='q' placeholder='Search' value='{{ query }}' />
        <button id='search-button' type='submit'>Search</button>
        {{#if isSearch}}
            <a id='clear-search-link' href='/'>Clear</a>
        {{/if}}
    </form>
</div>

{{#if isSearch}}
    {{#if query}}
        {{#if (gt pagination.totalCount 0)}}
            <div style='text-align: left; margin-bottom: 10px;'>
                <p>
                    Showing
                    {{ pagination.totalCount }}
                    result
                    {{#if (ne pagination.totalCount 1)}}
                        s
                    {{/if}}
                    for "
                    {{ query }} "
                </p>
            </div>
        {{/if}}
    {{/if}}
{{/if}}

<div id='post-list'>
    {{#if posts}}
        {{#each posts}}
            <div class='post' data-date='{{formatDateData this.createdAt}}'>
                <a class='post-link' href='/post/{{ this.id }}'>
                    <h2 class='post-title'>{{ truncateTitle this.title }}</h2>
                    <span class='post-date'>{{formatDate this.createdAt}}</span>
                </a>
                {{#if ../isAdmin}}
                    <div class='menu-wrapper'>
                        <button class='menu-button' aria-label='Post options'>⋯</button>
                        <div class='menu' role='menu'>
                            <a href='/update/{{ this.id }}' role='menuitem'>Edit</a>
                            <button
                                class='menu-delete delete-button'
                                data-id='{{ this.id }}'
                                role='menuitem'
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                {{/if}}
            </div>
        {{/each}}
    {{else}}
        <div id='no-results' style='text-align: left; font-size: 18px;'>
            <span id='result-text'>
                {{#if isSearch}}
                    No posts found for "{{ query }}"!
                {{else}}
                    No posts found!
                {{/if}}
            </span>
        </div>
    {{/if}}
</div>

{{#if pagination}}
    {{#if (gt pagination.totalPages 1)}}
        <div id='pagination'>
            {{#if (gt pagination.page 1)}}
                {{#if isSearch}}
                    <a
                        class='pagination-link'
                        href='/search?q={{ query }}&page={{subtract pagination.page 1}}'
                    >
                        Previous
                    </a>
                {{else}}
                    <a class='pagination-link' href='/?page={{subtract pagination.page 1}}'>
                        Previous
                    </a>
                {{/if}}
            {{/if}}

            {{#each (paginationPages pagination.page pagination.totalPages)}}
                {{#if (eq this '...')}}
                    <span class='pagination-ellipsis'>{{ this }}</span>
                {{else}}
                    {{#if (eq this ../pagination.page)}}
                        <span class='pagination-current'>
                            {{ this }}
                        </span>
                    {{else}}
                        {{#if ../isSearch}}
                            <a class='pagination-link' href='/search?q={{ ../query }}&page={{ this }}'>
                                {{ this }}
                            </a>
                        {{else}}
                            <a class='pagination-link' href='/?page={{ this }}'>
                                {{ this }}
                            </a>
                        {{/if}}
                    {{/if}}
                {{/if}}
            {{/each}}

            {{#if (lt pagination.page pagination.totalPages)}}
                {{#if isSearch}}
                    <a
                        class='pagination-link'
                        href='/search?q={{ query }}&page={{add pagination.page 1}}'
                    >
                        Next
                    </a>
                {{else}}
                    <a class='pagination-link' href='/?page={{add pagination.page 1}}'>Next</a>
                {{/if}}
            {{/if}}
        </div>
    {{/if}}
{{/if}}

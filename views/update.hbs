<form id='input-block' method='put' action=''>
    <h2 class='page-header'>Edit post</h2>
    <div id='form-error' class='form-error' style='display: none;'></div>
    <input name='title' type='text' placeholder='Title' maxlength='255' value='{{ post.title }}' required />
    <textarea id='initial-content' hidden>{{ post.content }}</textarea>
    <div>
        <div id='post-editor' aria-label='Post content'></div>
        <input type='hidden' name='content' />
    </div>
    <input
        name='category'
        type='text'
        placeholder='Category'
        maxlength='100'
        value='{{ post.category }}'
        required
    />
    <input type='submit' value='Update' />
    <input name='id' type='hidden' value='{{ post.id }}' />
</form>

{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "plugins": ["@poliklot/prettier-plugin-handlebars"],
    "overrides": [
        {
            "files": ["*.hbs", "*.handlebars"],
            "options": {
                "parser": "handlebars"
            }
        }
    ]
}
